<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="topbar"><a class="brand" href="/">Campus <span>Lost & Found</span></a><nav><a class="active" href="/lost-items">Lost Items</a><a href="/found-items">Found Items</a><a href="/students/new">Student Profile</a></nav></header>
<main class="page"><div class="page-heading"><div><p class="eyebrow">CAMPUS REPORTS</p><h1>Lost Items</h1><p class="muted">Items students have reported missing.</p></div><a class="button primary" href="/lost-items/new">+ Report Lost Item</a></div>
<form method="GET" action="/lost-items" class="searchbar"><input name="search" value="<%= search %>" placeholder="Search by item, category or location"><button class="button secondary" type="submit">Search</button><% if (search) { %><a class="text-link" href="/lost-items">Clear</a><% } %></form>
<% if (!items.length) { %><section class="empty"><div class="empty-icon">⌕</div><h2><%= search ? 'No matching reports found' : 'No lost items yet' %></h2><p><%= search ? 'Try another item name, category or location.' : 'When a student reports a lost item, it will appear here.' %></p><a class="button primary" href="/lost-items/new">Report an Item</a></section><% } else { %>
<section class="item-grid"><% items.forEach(item => { %><article class="item-card"><div class="item-top"><span class="pill lost">Lost</span><span class="category"><%= item.category %></span></div><h2><%= item.itemName %></h2><p class="muted"><%= item.lastSeenLocation %></p><p class="description"><%= item.description %></p><div class="card-bottom"><span>Reported by <%= item.reportedBy ? item.reportedBy.fullName : 'Unknown student' %></span><a href="/lost-items/<%= item._id %>">View details →</a></div></article><% }) %></section><% } %>
</main><footer>Campus Lost & Found Management System</footer></body></html>