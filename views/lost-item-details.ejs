<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="topbar"><a class="brand" href="/">Campus <span>Lost & Found</span></a><nav><a href="/lost-items">Lost Items</a><a href="/found-items">Found Items</a></nav></header>
<main class="page narrow"><a class="back" href="/lost-items">← All Lost Items</a><p class="eyebrow">LOST ITEM DETAILS</p><h1><%= item.itemName %></h1><section class="panel details"><p><strong>Status</strong><span><span class="pill lost"><%= item.status %></span></span></p><p><strong>Category</strong><span><%= item.category %></span></p><p><strong>Description</strong><span><%= item.description %></span></p><p><strong>Last Seen Location</strong><span><%= item.lastSeenLocation %></span></p><p><strong>Date Lost</strong><span><%= new Date(item.dateLost).toLocaleDateString() %></span></p><p><strong>Reported By</strong><span><%= item.reportedBy ? item.reportedBy.fullName : 'Unknown student' %></span></p><% if (item.reportedBy) { %><p><strong>Contact Email</strong><span><%= item.reportedBy.email %></span></p><% } %><p><strong>Report ID</strong><span class="id-text"><%= item._id %></span></p></section></main><footer>Campus Lost & Found Management System</footer></body></html>