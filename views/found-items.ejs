<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %></title><link rel="stylesheet" href="/styles.css"></head>
<body><header class="topbar"><a class="brand" href="/">Campus <span>Lost & Found</span></a><nav><a href="/lost-items">Lost Items</a><a class="active" href="/found-items">Found Items</a><a href="/students/new">Student Profile</a></nav></header>
<main class="page"><div class="page-heading"><div><p class="eyebrow">CAMPUS REPORTS</p><h1>Found Items</h1><p class="muted">Items found and reported by students.</p></div><a class="button primary" href="/found-items/new">+ Report Found Item</a></div>
<% if (!items.length) { %><section class="empty"><div class="empty-icon">✓</div><h2>No found items have been reported yet.</h2><p>Found items will appear here after students submit a report.</p><a class="button primary" href="/found-items/new">Report a Found Item</a></section><% } else { %>
<section class="item-grid"><% items.forEach(item => { %><article class="item-card"><div class="item-top"><span class="pill available"><%= item.status %></span><span class="category"><%= item.category %></span></div><h2><%= item.itemName %></h2><p class="muted"><%= item.foundLocation %></p><p class="description"><%= item.description %></p><div class="card-bottom"><span>Reported by <%= item.reportedBy ? item.reportedBy.fullName : 'Unknown student' %></span><a href="/found-items/<%= item._id %>">View details →</a></div></article><% }) %></section><% } %>
</main><footer>Campus Lost & Found Management System</footer></body></html>